# Database — Railway lo fornisce come reference variable quando attacchi un
# plugin Postgres a questo servizio.
DATABASE_URL="postgresql://user:password@localhost:5432/ai_control"

# --- Connettore Microsoft 365 / Entra (PRD §5.1) ---
# App registration in Entra, permessi applicativi con admin consent:
# Application.Read.All, AuditLog.Read.All, Directory.Read.All
MS365_TENANT_ID=""
MS365_CLIENT_ID=""
MS365_CLIENT_SECRET=""

# --- Connettore GitHub (PRD §5.2) ---
# GitHub App installata a livello organizzazione (non OAuth personale).
# Permessi: Organization members (read), Organization administration (read),
# Repository metadata (read).
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_INSTALLATION_ID=""
GITHUB_ORG=""

# --- Connettore Anthropic / Claude Enterprise (PRD §5.3) ---
# Admin API key dell'organizzazione (prefisso sk-ant-admin...), non una
# API key normale. Vede solo membri dell'org gestita, mai il contenuto
# delle conversazioni.
ANTHROPIC_ADMIN_API_KEY=""

# --- Connettore OpenAI / ChatGPT Enterprise-Edu (PRD §5.4) ---
# Admin API key generata a livello organizzazione (Settings -> Organization
# -> Admin keys), non una API key di progetto.
OPENAI_ADMIN_API_KEY=""
