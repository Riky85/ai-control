// AI Control — data model per PRD (AI-Control-PRD.md, sezione 4)
// Principio: il database e' sempre fonte di verita' per identita', permessi,
// risk score e stato di approvazione. Claude/LLM non scrive mai questi valori
// direttamente — puo' solo spiegarli (vedi src/lib/risk-engine.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConnectorProvider {
  MICROSOFT_365
  GITHUB
  ANTHROPIC
  OPENAI
  GOOGLE_WORKSPACE // predisposto, non attivo in MVP1
  GOOGLE_GEMINI
  MISTRAL
  GROQ
  COHERE
  DEEPSEEK
  XAI
  TOGETHER
  OPENROUTER
  HUGGINGFACE
  AZURE_OPENAI // spesa AI da Azure Cost Management (sottoscrizione del cliente)
  AWS_BEDROCK // spesa AI da AWS Cost Explorer (account del cliente)
  GOOGLE_VERTEX // spesa AI dall'export di fatturazione BigQuery (progetto del cliente)
  FATTURE_IN_CLOUD // fatture passive (Italia), per i costi
  BANK // conti bancari via Enable Banking (PSD2), per i costi
  ACCOUNTING // software di contabilità europei via Chift, per i costi
  NETWORK // scoperta automatica: scanner angar sui computer / log DNS e firewall
  CLOUDFLARE_GATEWAY // log DNS di Cloudflare Zero Trust Gateway (GraphQL Analytics API)
  CISCO_UMBRELLA // log DNS di Cisco Umbrella (Reporting API v2)
  JIRA // ticket automatici per anomalie e AI non consentite
  SERVICENOW // idem, per chi usa ServiceNow
  OKTA // identità: app AI assegnate in Okta, accessi SSO e consensi OAuth
}

enum ConnectorStatus {
  CONNECTED
  ERROR
  DISCONNECTED
  SYNCING
}

enum AiAssetType {
  AI_APPLICATION
  AI_FEATURE
  AI_API
  AI_AGENT
  MCP_SERVER
  AI_DEV_TOOL
}

enum AiAssetStatus {
  APPROVED
  UNREVIEWED
  UNAPPROVED
  UNKNOWN
}

// Classificazione EU AI Act — deliberatamente leggera (un tag, non un
// framework di conformità completo): serve come "reason to buy" per il
// buyer compliance/DPO, non come prodotto a sé stante (PRD §15 dei
// documenti di analisi: "l'AI Act deve essere una conseguenza, non il
// centro del prodotto").
enum EuAiActTier {
  UNCLASSIFIED
  MINIMAL_RISK
  LIMITED_RISK
  HIGH_RISK
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DataSensitivity {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  PII
  SOURCE_CODE
  FINANCIAL
}

// Libreria/istanze di policy — testo leggibile da un umano, valutato per
// ora manualmente (non da un rule engine runtime, quello è V4). Serve a
// dimostrare intento di governance, come il Policy Manager di OneTrust,
// senza costruire un motore di enforcement che non abbiamo ancora.
model Policy {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String
  category       String   // "data_access" | "approval" | "environment" | "vendor"
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  country   String?
  onboardingCompletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Abbonamento — aggiornato dal webhook Stripe quando i pagamenti sono attivi.
  plan                 Plan      @default(STARTER)
  planStatus           String    @default("trialing")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  // Prova gratuita (funzioni Growth): null = impostata al primo accesso (vedi plan-gate.ts).
  trialEndsAt          DateTime?
  // Add-on attivi (es. "COMPLIANCE") e il loro abbonamento Stripe separato.
  addons                    String[] @default([])
  stripeAddonSubscriptionId String?
  billingInterval           String?  // "month" | "year" (dall'ultimo checkout)
  // Angar Edge: dispositivi fisici in abbonamento (abbonamento Stripe separato).
  edgeDevices              Int     @default(0)
  // angar Engine — Autopilot dei risparmi: "off" | "approve" (propone, un clic per eseguire) | "auto" (esegue ciò che è sicuro e reversibile).
  autopilotMode            String  @default("approve")
  stripeEdgeSubscriptionId String?

  members    WorkspaceMember[]
  auditLogs  AuditLog[]
  shareLinks ShareLink[]
  users      User[]
  connectors Connector[]
  aiAssets   AiAsset[]
  dataAssets DataAsset[]
  evidence   Evidence[]
  policies   Policy[]

  // Token dello scanner di rete (solo hash SHA-256; il token si vede una volta).
  employees          Int? // numero dipendenti: spesa AI per dipendente
  discoveryTokenHash String? @unique
  discoveryTokenHint String?
  discoveryTokenEncrypted String? // per rimetterlo nell'estensione già configurata
  joinCode           String? @unique // link aziendale per collegare l'estensione

  spendRecords     SpendRecord[]
  savingDismissals SavingDismissal[]
  desktopDevices   DesktopDevice[]
  alerts           Alert[]
  budgets          Budget[]
  seatReminders    SeatReminder[]

  // Settore e fascia per il benchmark anonimo tra aziende simili.
  industry              String?
  // Webhook Slack o Microsoft Teams (cifrato): riepilogo settimanale e avvisi.
  chatWebhookEncrypted  String?

  // angar Edge: sensori di rete (software, dispositivo o log dal cloud).
  edgeSensors  EdgeSensor[]
  edgeEvents   EdgeEvent[]
  edgeHardware EdgeDevice[]
  // Presa visione della policy AI / AI literacy, API pubblica e webhook in uscita.
  policyAcks   PolicyAck[]
  apiKeys      ApiKey[]
  webhooks     Webhook[]
  // Privacy per i dipendenti: "individual" (per persona), "department"
  // (solo per reparto, gruppi di almeno 5), "anonymous" (solo totali azienda).
  privacyMode  String @default("individual")
  // Chiave (hex) per gli pseudonimi delle persone quando la privacy non è "per persona":
  // p_ + HMAC-SHA256(privacySalt, email). Generata al primo uso.
  privacySalt  String?
  desktopTokens DesktopToken[]
  // Avviso quando un dispositivo carica più di N MB al giorno su un'AI non approvata.
  uploadAlertMb Int   @default(100)
  // Ultimo "Reset workspace data": le app desktop con dati più vecchi rimandano la cronologia.
  dataResetAt   DateTime?
  // Partner (MSP / integratore) che gestisce questo workspace, se c'è.
  managedByPartnerId String?
  // Gruppo societario (holding): vista consolidata tra più workspace.
  groupId            String?
  group              OrgGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  costCenters        CostCenter[]
  accountingSettings AccountingSettings?
  // Sicurezza d'accesso: SSO obbligatorio (per tutti o solo per ssoDomain) e MFA per chi entra con password.
  ssoRequired Boolean @default(false)
  ssoDomain   String?
  mfaRequired Boolean @default(false)
  // Posti liberati ("non mi serve" o nessuna risposta in 7 giorni): toglierli da soli via API del fornitore.
  autoRemoveSeats Boolean @default(false)
  // Modalità solo UE del workspace (Settings → Privacy): niente risposte AI via Anthropic. null = spenta.
  euOnly          Boolean?
  savingActions   SavingAction[]
  engineSnapshots EngineSnapshot[]
  autopilotTasks  AutopilotTask[]
  // angar Gateway: proxy compatibile OpenAI / Anthropic con chiavi virtuali, policy e log di soli metadati.
  gatewayKeys      GatewayKey[]
  gatewayPolicy    GatewayPolicy?
  gatewayUpstreams GatewayUpstream[]
  gatewayRequests  GatewayRequest[]
  // Economia AI: abbonamenti normalizzati (piano, tipi di posto, listino vs fatturato).
  customerSubscriptions CustomerSubscription[]
  // AI Estate: processi, applicazioni, uso dei modelli, archi del grafo, prove delle alternative.
  businessProcesses BusinessProcess[]
  applications      Application[]
  aiModelUses       AiAssetModelUse[]
  dependencies      Dependency[]
  aiEvaluations     AiEvaluation[]
  // Impatto dei cambiamenti del mercato AI sull'estate (market/).
  aiMarketChangeImpacts AiMarketChangeImpact[]
}

// Avvisi della piattaforma (campanella in alto a destra): rinnovi in arrivo,
// budget superati, AI non consentite usate, posti da liberare.
model Alert {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           String // "renewal" | "budget" | "policy" | "seats" | "new_ai" | "info"
  severity       String       @default("info") // "info" | "warning" | "critical"
  title          String
  body           String
  href           String?
  // Evita doppioni: lo stesso avviso (es. rinnovo di X il giorno Y) si crea una volta sola.
  dedupeKey      String
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, createdAt])
}

// Budget AI mensile per reparto (department delle persone).
model Budget {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department     String
  monthlyEur     Float
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, department])
}

// "Ti serve ancora il posto?": email alla persona inattiva con due link
// (tengo / libera). Senza risposta in 7 giorni il posto va in "da togliere".
model SeatReminder {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aiAssetId      String
  email          String
  token          String       @unique
  sentAt         DateTime     @default(now())
  respondedAt    DateTime?
  response       String? // "keep" | "release"
  removedAt      DateTime? // l'amministratore ha tolto il posto

  @@unique([aiAssetId, email])
  @@index([organizationId])
}

// Lavori periodici già eseguiti (scheduler interno): uno per nome + chiave (es. giorno).
model JobRun {
  id    String   @id @default(cuid())
  name  String
  key   String
  ranAt DateTime @default(now())
  // "running" mentre il lavoro gira, "done" a fine lavoro (default per le righe vecchie).
  status String @default("done")

  @@unique([name, key])
}

// Contatti dal controllo gratuito della spesa AI (/check): per il commerciale.
model Lead {
  id          String   @id @default(cuid())
  email       String
  company     String?
  annualSpend Float?
  savings     Float?
  aiCount     Int?
  summary     Json?
  // Da dove arriva: "check" (Spend Check), "partner" (commercialisti / MSP), "pilot" (aziende pilota).
  kind        String   @default("check")
  name        String?
  country     String?
  phone       String?
  message     String?
  clients     Int?     // partner: numero di clienti seguiti
  createdAt   DateTime @default(now())
  // Doppio opt-in: il report parte solo dopo il clic sul link di conferma (hash del token).
  confirmTokenHash String?   @unique
  confirmedAt      DateTime?

  @@index([createdAt])
  @@index([kind, createdAt])
}

// Un computer su cui è installata l'app desktop angar. Serve a mostrare, sulla
// piattaforma, che l'app è collegata e sta inviando dati (chi, quale sistema,
// quale versione, ultimo contatto). Chiave = azienda + host + email.
model DesktopDevice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deviceKey      String // host normalizzato + email, univoco per azienda
  host           String
  email          String?
  os             String?
  appVersion     String?
  aiCount        Int          @default(0)
  syncCount      Int          @default(0)
  // IP locali del computer: angar Edge li usa per sapere di chi è il traffico.
  ips            String[]     @default([])
  firstSeenAt    DateTime     @default(now())
  lastSeenAt     DateTime     @default(now())

  @@unique([organizationId, deviceKey])
  @@index([organizationId, lastSeenAt])
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  name           String?
  department     String?
  role           String       @default("member")
  externalIds    Json?
  createdAt      DateTime     @default(now())

  ownedAssets AiAsset[]      @relation("AssetOwner")
  usages      AiAssetUsage[]

  @@unique([organizationId, email])
}

model Connector {
  id                   String            @id @default(cuid())
  organizationId       String
  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider             ConnectorProvider
  status               ConnectorStatus   @default(SYNCING)
  credentialsEncrypted String?           @db.Text
  scopes               String[]
  lastSyncedAt         DateTime?
  lastSyncError        String?
  lastSyncWarnings     Json?
  // Storico email (solo Microsoft 365 / Google Workspace): null = acceso se c'è il permesso.
  emailScanEnabled     Boolean?
  // Stato dell'ultima scansione email (connectors/email-history.ts): data, esito, servizi trovati.
  emailScanState       Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  assets       AiAsset[]
  emailHistory EmailHistory[]

  @@unique([organizationId, provider])
}

// Segnali email dei servizi AI, una riga per casella: solo servizio, date e
// conteggi per tipo (iscrizione, accesso, ricevuta, altro). Mai oggetto né testo.
// personRef: sempre pseudonimo (p_…, HMAC con la chiave dell'azienda), in ogni modalità di privacy.
model EmailHistory {
  id             String    @id @default(cuid())
  organizationId String
  connectorId    String
  connector      Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  personRef      String
  // Cursore incrementale: messaggi ricevuti fino a questo istante già contati.
  scannedUntil   DateTime?
  // { [serviceId]: { first, last, signup, login, billing, other } }
  signals        Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([connectorId, personRef])
  @@index([organizationId])
}

model DataAsset {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  sensitivity    DataSensitivity @default(INTERNAL)
  createdAt      DateTime        @default(now())

  accessedBy AiAssetDataAccess[]

  @@unique([organizationId, name])
}

model AiAsset {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type   AiAssetType
  name   String
  vendor String?
  model  String?
  serviceId String? // servizio del catalogo (discovery/catalog.ts): chatgpt, claude, openai-api…

  connectorId String?
  connector   Connector? @relation(fields: [connectorId], references: [id])
  externalId  String?

  ownerId    String?
  owner      User?   @relation("AssetOwner", fields: [ownerId], references: [id])
  department String?

  status AiAssetStatus @default(UNKNOWN)
  // Bloccata sulla rete aziendale da angar Edge (DNS), con l'AI approvata da suggerire.
  blockOnNetwork Boolean @default(false)
  insteadAssetId String?
  euAiActTier EuAiActTier @default(UNCLASSIFIED)
  // Classe AI Act scelta a mano (compliance/ai-act.ts): "prohibited" | "high" | "limited" | "minimal" | "gpai"; null = automatica.
  aiActTier String?
  aiActNote String?
  // Registro GDPR art. 30: campi completati a mano (finalità, dati, interessati, conservazione…), sopra a quelli dedotti.
  ropa Json?

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  connectedSystems AiAssetConnectedSystem[]
  dataAccess       AiAssetDataAccess[]
  usages           AiAssetUsage[]
  riskAssessments  RiskAssessment[]
  assuranceReports AssuranceReport[]
  activities       AiAssetActivity[]
  changes          AssetChange[]
  cost             AiSystemCost?
  alternatives     ModelAlternative[]
  subscriptions    CustomerSubscription[]
  relationsFrom    AiAssetRelationship[]    @relation("RelationSource")
  relationsTo      AiAssetRelationship[]    @relation("RelationTarget")
  spendRecords     SpendRecord[]
  // AI Estate: modelli usati, requisiti dichiarati, prove delle alternative.
  modelUses        AiAssetModelUse[]
  profile          AiSystemProfile?
  evaluations      AiEvaluation[]

  @@unique([organizationId, connectorId, externalId])
  @@index([organizationId, type])
  @@index([organizationId, status])
}

// Un cambiamento materiale rilevato su un campo di dipendenza (modello,
// vendor...) tra un sync e il successivo. Confronto diretto valore-vecchio
// vs valore-nuovo dal connettore — nessuna inferenza, solo un fatto:
// "questo campo era X, ora è Y". Rende il Passaporto "vivo" invece che
// una fotografia statica.
model AssetChange {
  id        String   @id @default(cuid())
  aiAssetId String
  aiAsset   AiAsset  @relation(fields: [aiAssetId], references: [id], onDelete: Cascade)
  field     String   // "model" | "vendor" | "status"
  oldValue  String?
  newValue  String?
  detectedAt DateTime @default(now())

  @@index([aiAssetId, detectedAt])
}

// Costo di un AI system — solo inserimento manuale in questa prima versione.
// Nessun calcolo automatico da token/utilizzo: non abbiamo un connettore di
// billing reale, e stimare una cifra precisa senza dati veri violerebbe il
// principio seguito in tutto il prodotto (mai un numero senza un fatto
// dietro). "confidence" e "basis" restano sempre visibili in UI.
model AiSystemCost {
  id                  String   @id @default(cuid())
  aiAssetId           String   @unique
  aiAsset             AiAsset  @relation(fields: [aiAssetId], references: [id], onDelete: Cascade)
  monthlyCostEstimate Float?
  basis               String   @default("manual") // "manual" | "csv_import" | "billing_connector" | "bank" | "invoice" | "estimate"
  confidence          String   @default("MEDIUM")  // "LOW" | "MEDIUM" | "HIGH"
  notes               String?
  planId              String?  // piano di listino riconosciuto (pricing/catalog.ts)
  seats               Int?     // posti stimati dall'importo
  annualBilling       Boolean  @default(false)
  updatedAt           DateTime @updatedAt
  // Registro contratti e rinnovi (inserito a mano dal CFO / owner).
  contractStart       DateTime?
  contractEnd         DateTime?
  noticeDays          Int?     // preavviso di disdetta, in giorni prima di contractEnd
  autoRenew           Boolean?
  poNumber            String?
  costCenter          String?
  contractOwnerEmail  String?
  contractUrl         String?  // link al contratto (nessun archivio file in angar)
}

// Un'alternativa registrata manualmente per un AI system — mai generata
// automaticamente: l'utente (o chi valuta) inserisce cosa ha confrontato e
// perché. "reasoning" è testo libero, non un punteggio nascosto.
model ModelAlternative {
  id                   String   @id @default(cuid())
  aiAssetId            String
  aiAsset              AiAsset  @relation(fields: [aiAssetId], references: [id], onDelete: Cascade)
  provider             String
  model                String
  estimatedMonthlyCost Float?
  qualityConfidence    String?  // "LOW" | "MEDIUM" | "HIGH"
  migrationEffortDays  String?  // testo libero tipo "3-5", mai un numero finto-preciso
  reasoning            String?
  createdAt            DateTime @default(now())
}

model AiAssetConnectedSystem {
  id        String   @id @default(cuid())
  aiAssetId String
  aiAsset   AiAsset  @relation(fields: [aiAssetId], references: [id], onDelete: Cascade)
  system    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([aiAssetId])
}

model AiAssetDataAccess {
  id          String    @id @default(cuid())
  aiAssetId   String
  aiAsset     AiAsset   @relation(fields: [aiAssetId], references: [id], onDelete: Cascade)
  dataAssetId String
  dataAsset   DataAsset @relation(fields: [dataAssetId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([aiAssetId, dataAssetId])
}

model AiAssetRelationship {
  id            String   @id @default(cuid())
  sourceAssetId String
  sourceAsset   AiAsset  @relation("RelationSource", fields: [sourceAssetId], references: [id], onDelete: Cascade)
  targetAssetId String
  targetAsset   AiAsset  @relation("RelationTarget", fields: [targetAssetId], references: [id], onDelete: Cascade)
  relationType  String
  createdAt     DateTime @default(now())

  @@unique([sourceAssetId, targetAssetId, relationType])
}

model AiAssetUsage {
  id                  String    @id @default(cuid())
  aiAssetId           String
  aiAsset             AiAsset   @relation(fields: [aiAssetId], references: [id], onDelete: Cascade)
  userId              String?
  user                User?     @relation(fields: [userId], references: [id])
  externalUserRef     String?
  firstSeenAt         DateTime  @default(now())
  lastSeenAt          DateTime?
  messageOrEventCount Int?

  @@unique([aiAssetId, userId])
  @@index([aiAssetId])
}

model AiAssetActivity {
  id         String            @id @default(cuid())
  aiAssetId  String
  aiAsset    AiAsset           @relation(fields: [aiAssetId], references: [id], onDelete: Cascade)
  source     ConnectorProvider
  eventType  String
  actorRef   String?
  occurredAt DateTime
  payload    Json?
  createdAt  DateTime          @default(now())

  @@index([aiAssetId, occurredAt])
}

model RiskAssessment {
  id          String    @id @default(cuid())
  aiAssetId   String
  aiAsset     AiAsset   @relation(fields: [aiAssetId], references: [id], onDelete: Cascade)
  level       RiskLevel
  score       Int
  reasons     Json
  mitigations Json
  createdAt   DateTime  @default(now())

  @@index([aiAssetId, createdAt])
}

enum AssuranceLevel {
  ASSURED
  NEEDS_REVIEW
  RESTRICTED
  BLOCKED
}

// Snapshot dei controlli di assurance calcolati per un asset — stessa
// architettura di RiskAssessment: ricalcolato deterministicamente a ogni
// sync, mai deciso da un LLM. "checks" è un array Json di
// { key, label, status: "PASSED"|"WARNING"|"FAILED", detail }.
model AssuranceReport {
  id            String         @id @default(cuid())
  aiAssetId     String
  aiAsset       AiAsset        @relation(fields: [aiAssetId], references: [id], onDelete: Cascade)
  level         AssuranceLevel
  score         Int            // 0-100
  passedCount   Int
  warningCount  Int
  failedCount   Int
  checks        Json
  createdAt     DateTime       @default(now())

  @@index([aiAssetId, createdAt])
}

model Evidence {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String
  summary        String
  payload        Json
  createdAt      DateTime     @default(now())

  @@index([organizationId, type])
}


enum Plan {
  FREE
  STARTER
  GROWTH
  SCALE
  ENTERPRISE
}

enum MemberRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

// Chi usa Angar (diverso da User, che sono le persone dell'azienda scoperte
// dai connettori e proprietarie dei sistemi AI).
model WorkspaceMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  name           String?
  role           MemberRole   @default(VIEWER)
  status         String       @default("invited") // invited | active
  invitedAt      DateTime     @default(now())
  // Link d'invito (inviato per email): solo chi lo apre entra nel workspace.
  inviteToken    String?      @unique

  @@unique([organizationId, email])
}

// Link di sola lettura a una dashboard, condivisibile fuori da Angar.
model ShareLink {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  token          String       @unique
  name           String
  dashboard      String       @default("overview")
  createdAt      DateTime     @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  viewCount      Int          @default(0)
  lastViewedAt   DateTime?
}

// Account di accesso ad Angar (email + password). L'appartenenza ai
// workspace e il ruolo stanno in WorkspaceMember (collegati per email).
model Account {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  // Accesso con Microsoft/Google senza password (passwordHash inutilizzabile).
  ssoOnly             Boolean   @default(false)
  emailVerifiedAt     DateTime?
  // MFA TOTP (RFC 6238): segreto cifrato; attivo solo con totpEnabledAt.
  totpSecretEncrypted String?
  totpEnabledAt       DateTime?
  totpLastStep        Int?
  recoveryCodesHash   String[]  @default([])
}

// Registro di audit: chi ha fatto cosa, quando, da dove. Solo in aggiunta.
model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorEmail     String?
  action         String
  target         String?
  meta           Json?
  ip             String?
  createdAt      DateTime      @default(now())
  // Catena di hash (registro a prova di manomissione per AI Act / NIS2).
  prevHash       String?
  hash           String?

  @@index([organizationId, createdAt])
}

// Link di reset password: nel database solo l'hash del token, scade in 1 ora, monouso.
model PasswordResetToken {
  id        String    @id @default(cuid())
  accountId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([accountId])
}

// Errori applicativi (server e browser) — visibili nella pagina System.
model ErrorEvent {
  id             String   @id @default(cuid())
  organizationId String?
  source         String   // server | client
  message        String
  digest         String?
  path           String?
  stack          String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

// Storico dei backup automatici (scritto dalla funzione di backup su Railway).
model BackupRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    // running | ok | failed
  tables     Int       @default(0)
  rows       Int       @default(0)
  bytes      Int       @default(0)
  location   String?
  error      String?
}

// Un addebito riconosciuto come AI (estratto conto, fattura elettronica).
// Solo le righe AI vengono salvate: il resto dell'estratto conto non resta.
model SpendRecord {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aiAssetId      String?
  aiAsset        AiAsset?     @relation(fields: [aiAssetId], references: [id], onDelete: SetNull)
  service        String
  source         String       // "bank" | "invoice"
  date           DateTime
  amountEur      Float
  description    String
  fingerprint    String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, fingerprint])
  @@index([organizationId, date])
}

// Un suggerimento di risparmio che l'utente ha scartato ("non per noi").
model SavingDismissal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, key])
}

// angar Edge: un sensore di rete. kind: "software" (Docker / Linux / Raspberry),
// "hardware" (dispositivo angar), "cloud" (log inviati da Cloudflare, Zscaler…).
model EdgeSensor {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  kind           String       @default("software")
  tokenHash      String       @unique
  tokenHint      String
  // Impostazioni scelte sulla piattaforma e lette dal sensore.
  dnsEnabled     Boolean      @default(true)
  syslogEnabled  Boolean      @default(true)
  blockEnabled   Boolean      @default(false)
  scanLan        Boolean      @default(false)
  // Riportati dal sensore.
  version        String?
  os             String?
  hostIp         String?
  stats          Json?
  lastSeenAt     DateTime?
  createdAt      DateTime     @default(now())
  createdBy      String?
  events         EdgeEvent[]
  device         EdgeDevice?

  @@index([organizationId])
}

// Registro di fabbrica dei dispositivi angar (box fisici): seriale sull'etichetta,
// hash del segreto di claim, stato e sensore collegato. Protocollo: docs/edge-protocol.md.
model EdgeDevice {
  id              String        @id @default(cuid())
  serial          String        @unique // AE-XXXX-XXXX
  claimSecretHash String        // SHA-256 hex del segreto scritto nel device
  model           String        // "n100" | "pi5"
  status          String        @default("stock") // stock | claimed | returned | retired
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  sensorId        String?       @unique
  sensor          EdgeSensor?   @relation(fields: [sensorId], references: [id], onDelete: SetNull)
  batch           String?
  notes           String?
  createdAt       DateTime      @default(now())
  claimedAt       DateTime?
  lastClaimCallAt DateTime?

  @@index([organizationId])
  @@index([status])
}

// Traffico verso le AI visto da un sensore, aggregato per giorno, AI e dispositivo.
// Mai URL o contenuti: solo il servizio, quante richieste, quanti byte in uscita.
model EdgeEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sensorId       String
  sensor         EdgeSensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  day            String       // YYYY-MM-DD
  serviceId      String       // id del catalogo, "cand:<dominio>" o "local:<runtime>"
  serviceName    String
  kind           String       // "web" | "api" | "local-model"
  client         String       // IP del dispositivo, oppure "*" in modalità anonima
  clientLabel    String?      // nome host o persona (se nota)
  hits           Int          @default(0)
  bytesUp        BigInt       @default(0)
  blocked        Int          @default(0)
  source         String       // "dns" | "syslog:<vendor>" | "cloud:<vendor>" | "scan"
  updatedAt      DateTime     @updatedAt

  @@unique([sensorId, day, serviceId, client, source])
  @@index([organizationId, day])
}

// Token per singola installazione dell'app desktop (dal link aziendale). Il primo
// invio lo lega a una persona: dopo, invii con un'altra email vengono rifiutati.
// "email" è lo pseudonimo (p_…) dell'email, così vale in ogni modalità privacy.
model DesktopToken {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  email          String?
  deviceKey      String?
  createdAt      DateTime     @default(now())
  lastUsedAt     DateTime?
  revokedAt      DateTime?

  @@index([organizationId])
}

// Registro dei risparmi realizzati: un suggerimento accettato → fatto →
// verificato sugli addebiti reali (SpendRecord) dopo doneAt. Base della garanzia 90 giorni.
model SavingAction {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assetId            String?
  kind               String       // "seat_removed" | "plan_downgrade" | "duplicate_removed" | "annual_billing" | "cancelled" | "other"
  title              String
  expectedMonthlyEur Float
  status             String       @default("accepted") // "accepted" | "done" | "verified" | "failed"
  savingKey          String?      // chiave del suggerimento (savings.ts) da cui è nato
  seatReminderId     String?      @unique // posto tolto (pulizia posti), una riga per posto
  acceptedAt         DateTime     @default(now())
  doneAt             DateTime?
  verifiedAt         DateTime?
  verifiedMonthlyEur Float?
  createdBy          String
  note               String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([organizationId, status])
}

// Link di verifica email dopo la registrazione con password (nel DB solo l'hash).
model EmailVerificationToken {
  id        String    @id @default(cuid())
  accountId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([accountId])
}

// Gruppo societario (holding): più workspace con vista consolidata. Ognuno vede
// solo le società in cui è OWNER/ADMIN attivo.
model OrgGroup {
  id            String         @id @default(cuid())
  name          String
  createdBy     String
  createdAt     DateTime       @default(now())
  organizations Organization[]
}

// Centro di costo per reparto (chargeback / showback, export DATEV KOST1).
model CostCenter {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department     String
  code           String
  name           String?
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, department])
}

// Conti per gli export contabili del chargeback (DATEV, TeamSystem).
model AccountingSettings {
  id              String       @id @default(cuid())
  organizationId  String       @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenseAccount  String?
  clearingAccount String?
  datevConsultant String?
  datevClient     String?
  updatedAt       DateTime     @updatedAt
}

// Presa visione della policy AI + mini-modulo di AI literacy (AI Act art. 4).
// Una riga per persona e versione della policy (link personale /ack/[token]).
// Con la privacy per reparto / solo totali si usa il link generico: una riga
// per completamento con email "" (solo conteggi, nessuna persona).
model PolicyAck {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  policyVersion  String
  token          String       @unique
  lang           String?
  sentAt         DateTime     @default(now())
  openedAt       DateTime?
  acknowledgedAt DateTime?
  quizScore      Int?
  remindedAt     DateTime?
  reminders      Int          @default(0)

  @@index([organizationId, policyVersion])
  @@index([organizationId, email])
}

// Chiavi per l'API REST pubblica (sola lettura): nel database solo l'hash SHA-256.
model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  keyHash        String       @unique
  hint           String
  scopes         String[]     @default(["read"])
  createdBy      String
  createdAt      DateTime     @default(now())
  lastUsedAt     DateTime?
  revokedAt      DateTime?

  @@index([organizationId])
}

// Webhook in uscita (eventi firmati con HMAC-SHA256 nell'header X-Angar-Signature).
model Webhook {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  url             String
  secretEncrypted String
  events          String[]
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  createdBy       String?
  lastStatus      String?
  lastSentAt      DateTime?

  @@index([organizationId])
}

// angar Engine — fotografia giornaliera dell'angar Score (per l'andamento nel tempo).
model EngineSnapshot {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  day            String       // AAAA-MM-GG (ora di Roma)
  score          Int          // 0..100
  axes           Json         // { efficiency, governance, risk, adoption } 0..100
  monthlySpendEur Float?
  wasteMonthlyEur Float?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, day])
  @@index([organizationId, createdAt])
}

// angar Engine — Autopilot: un'azione di risparmio pianificata, approvata ed eseguita da angar.
model AutopilotTask {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  savingKey          String       // chiave del suggerimento (savings.ts)
  kind               String       // "seats" | "annual" | "duplicate" | "premium" | "model" | "idle" | "alternative" | "renewal"
  title              String
  expectedMonthlyEur Float
  status             String       @default("proposed") // "proposed" | "approved" | "running" | "done" | "failed" | "dismissed"
  steps              Json         // [{ label, auto: boolean, done: boolean, at?: string, detail?: string }]
  result             String?
  approvedBy         String?
  approvedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([organizationId, savingKey])
  @@index([organizationId, status])
}

// ── angar Gateway ────────────────────────────────────────────────────────
// Chiave virtuale "agk_…" che le app usano al posto della chiave del provider.
// Nel database solo l'hash SHA-256 e le ultime 4 cifre: la chiave si vede una volta.
model GatewayKey {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                String
  team                String       @default("")
  keyHash             String       @unique
  last4               String
  provider            String       @default("any") // "openai" | "anthropic" | "any"
  // Override della policy dell'azienda per questa chiave (null / vuoto = vale la policy dell'azienda).
  monthlyCapEur       Float?
  allowedModels       String[]     @default([])
  redactOverride      Boolean?
  blockHealthOverride Boolean?
  createdBy           String
  createdAt           DateTime     @default(now())
  lastUsedAt          DateTime?
  revokedAt           DateTime?

  @@index([organizationId])
}

// Regole del Gateway per azienda (una riga; senza riga valgono i default).
model GatewayPolicy {
  id               String       @id @default(cuid())
  organizationId   String       @unique
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  euOnly           Boolean      @default(false)
  redact           Boolean      @default(true)
  redactKinds      String[]     @default(["IBAN", "TAX_CODE", "EMAIL", "CARD", "PHONE"])
  blockHealth      Boolean      @default(true)
  modelsRestricted Boolean      @default(false)
  allowedModels    String[]     @default([])
  // Tetti mensili in EUR per team: { "Marketing": 500 }.
  teamCaps         Json?
  // Richieste al minuto per chiave.
  rpmLimit         Int          @default(600)
  updatedBy        String?
  updatedAt        DateTime     @updatedAt
}

// Provider a valle: chiave del provider (cifrata) e base URL opzionale (es. Azure OpenAI UE, Mistral).
model GatewayUpstream {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider             String       // "openai" | "anthropic"
  credentialsEncrypted String?      @db.Text
  keyLast4             String?
  baseUrl              String?
  // Dichiarato dall'admin: l'endpoint è ospitato nell'UE (serve con la modalità solo UE).
  euHosted             Boolean      @default(false)
  updatedBy            String?
  updatedAt            DateTime     @updatedAt

  @@unique([organizationId, provider])
}

// Log del Gateway: SOLO metadati. Mai testo del prompt né della risposta.
model GatewayRequest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  keyId          String?
  keyName        String       @default("")
  keyLast4       String       @default("")
  team           String       @default("")
  provider       String
  endpoint       String
  model          String?
  stream         Boolean      @default(false)
  inputTokens    Int          @default(0)
  outputTokens   Int          @default(0)
  costEur        Float        @default(0)
  latencyMs      Int          @default(0)
  overheadMs     Int?
  status         Int
  result         String       // "allowed" | "redacted" | "blocked" | "error"
  reason         String?      // "model_not_allowed" | "cap_exceeded" | "health_data" | "eu_only" | "rate_limited" | "upstream_error" | ...
  redactions     Json?        // { "IBAN": 1, "EMAIL": 2 }
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([keyId, createdAt])
}

// ───────────────────────── Economia AI: catalogo globale ─────────────────────────
// Catalogo prezzi AI CONDIVISO tra tutte le aziende (nessun organizationId):
// fornitori, prodotti, piani, tipi di posto, modelli, deployment e regole di prezzo.
// Fonte dei dati: src/lib/pricing/catalog-data/*.ts, caricati da pricing/catalog-sync.ts
// (idempotente, a ogni deploy e nel job giornaliero). Ogni prezzo ha provenienza
// (URL, tipo di fonte, verificato il, confidenza) e date di validità: un prezzo nuovo
// è una riga nuova, quella vecchia resta (storico). Mai sovrascrivere un prezzo.

model AiProvider {
  id              String   @id // slug: "openai", "anthropic", "google", "mistral", "microsoft", "aws"…
  name            String
  kind            String   // "model_provider" | "cloud" | "app_vendor"
  website         String?
  pricingUrl      String?
  hqRegion        String?  // "US" | "EU" | …
  euDataResidency Boolean? // null = non noto
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  products    AiProduct[]
  models      AiModel[]
  deployments AiDeployment[]
}

// Un prodotto vendibile: un abbonamento a posti (ChatGPT Business) o un'API (OpenAI API).
model AiProduct {
  id           String     @id // "chatgpt", "openai-api", "github-copilot"…
  providerId   String
  provider     AiProvider @relation(fields: [providerId], references: [id])
  name         String
  kind         String     // "seat" | "api" | "hybrid"
  serviceId    String?    // servizio di discovery/catalog.ts (riconoscimento da banca, scansione…)
  billingModel String     // SEAT_BASED | USAGE_BASED | TOKEN_BASED | CREDIT_BASED | HYBRID | CONTRACTED | CUSTOM
  website      String?
  pricingUrl   String?
  updatedAt    DateTime   @updatedAt
  createdAt    DateTime   @default(now())

  plans         AiPlan[]
  pricingRules  AiPricingRule[]
  subscriptions CustomerSubscription[]

  @@index([serviceId])
}

model AiPlan {
  id           String    @id // "chatgpt-business", "claude-team"…
  productId    String
  product      AiProduct @relation(fields: [productId], references: [id])
  name         String
  audience     String    // "personal" | "business" | "enterprise"
  billingModel String
  minSeats     Int?
  maxSeats     Int?
  status       String    @default("active") // "active" | "retired"
  notes        String?
  updatedAt    DateTime  @updatedAt
  createdAt    DateTime  @default(now())

  seatTypes     AiSeatType[]
  pricingRules  AiPricingRule[]
  subscriptions CustomerSubscription[]

  @@index([productId])
}

// Tipo di posto di un piano (Standard, Premium…): un abbonamento può averne più d'uno.
model AiSeatType {
  id           String   @id // "chatgpt-business:premium"
  planId       String
  plan         AiPlan   @relation(fields: [planId], references: [id])
  key          String   // "standard" | "premium" | "developer" | …
  name         String
  isDefault    Boolean  @default(false)
  // Id del vecchio catalogo (AiSystemCost.planId), per non perdere i dati già salvati.
  legacyPlanId String?  @unique
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  pricingRules AiPricingRule[]
  seatLines    CustomerSeatLine[]

  @@unique([planId, key])
}

model AiModel {
  id             String     @id // "openai:gpt-6.1-sol"
  providerId     String
  provider       AiProvider @relation(fields: [providerId], references: [id])
  apiId          String     // id come lo usa l'API: "gpt-6.1-sol", "claude-sonnet-5"
  name           String
  family         String     // "GPT-6", "Claude Sonnet", "Gemini Flash"…
  tier           String?    // "frontier" | "balanced" | "light" (per i confronti, mai per la compatibilità)
  lifecycle      String     // "active" | "preview" | "deprecated" | "sunset" | "retired"
  releasedAt     DateTime?
  deprecatedAt   DateTime?
  retiresAt      DateTime?
  replacementId  String?
  contextWindow  Int?
  maxOutput      Int?
  modalitiesIn   String[]   @default([]) // "text" | "image" | "audio" | "video" | "pdf"
  modalitiesOut  String[]   @default([])
  // Capacità: { toolCalling, structuredOutput, vision, audio, reasoning, batch, caching,
  // streaming, embeddings, fineTuning, mcp } — true / false, assente = non noto.
  capabilities   Json
  sourceUrl      String?
  sourceType     String     // "official" | "secondary" | "customer" | "angar_estimate"
  lastVerifiedAt DateTime
  confidence     String     // "HIGH" | "MEDIUM" | "LOW"
  updatedAt      DateTime   @updatedAt
  createdAt      DateTime   @default(now())

  pricingRules AiPricingRule[]

  @@unique([providerId, apiId])
}

// Dove si compra un modello: API diretta, Azure, Bedrock, Vertex… (stesso modello, prezzi diversi).
model AiDeployment {
  id             String     @id // "openai-direct", "azure-openai", "aws-bedrock", "google-vertex"
  kind           String     // "DIRECT_API" | "AZURE" | "BEDROCK" | "VERTEX" | "OTHER"
  hostProviderId String
  hostProvider   AiProvider @relation(fields: [hostProviderId], references: [id])
  name           String
  regions        String[]   @default([]) // "global", "eu", "us", "eu-central-1"…
  updatedAt      DateTime   @updatedAt
  createdAt      DateTime   @default(now())

  pricingRules AiPricingRule[]
}

// Una regola di prezzo: COSA si paga (modello o piano / tipo di posto), DOVE (deployment)
// e COME (modello di fatturazione, ciclo). Le voci con i numeri sono AiPricingComponent.
model AiPricingRule {
  id           String        @id // chiave stabile: "model:openai:gpt-6.1-sol@openai-direct", "seat:chatgpt-business:premium"
  billingModel String        // SEAT_BASED | USAGE_BASED | TOKEN_BASED | CREDIT_BASED | HYBRID | CONTRACTED | CUSTOM
  modelId      String?
  model        AiModel?      @relation(fields: [modelId], references: [id])
  productId    String?
  product      AiProduct?    @relation(fields: [productId], references: [id])
  planId       String?
  plan         AiPlan?       @relation(fields: [planId], references: [id])
  seatTypeId   String?
  seatType     AiSeatType?   @relation(fields: [seatTypeId], references: [id])
  deploymentId String?
  deployment   AiDeployment? @relation(fields: [deploymentId], references: [id])
  minSeats     Int?
  notes        String?
  updatedAt    DateTime      @updatedAt
  createdAt    DateTime      @default(now())

  components AiPricingComponent[]

  @@index([modelId])
  @@index([planId])
}

// Una voce di prezzo VERSIONATA: input, output, cache, batch, posto mensile/annuale…
// Mai sovrascritta: un cambio di prezzo chiude la riga (effectiveUntil) e ne apre una nuova,
// che ricorda il prezzo precedente e quando angar se n'è accorto (detectedAt).
model AiPricingComponent {
  id             String        @id @default(cuid())
  ruleId         String
  rule           AiPricingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  kind           String        // input | output | cached_input | cache_write | cache_write_1h | reasoning | image_input | audio_input | audio_output | image_output | embedding | search | tool_call | session_hour | credit | seat_monthly | seat_annual
  unit           String        // "1M_tokens" | "seat_month" | "1K_requests" | "image" | "hour" | "credit"
  price          Float
  currency       String        // "USD" | "EUR"
  region         String        @default("global") // "global" | "eu" | "us" | regione cloud
  serviceTier    String        @default("standard") // standard | batch | flex | priority | fast | promotion
  contextAbove   Int           @default(0) // prezzo valido per prompt OLTRE questi token (0 = tutti)
  effectiveFrom  DateTime
  effectiveUntil DateTime?
  sourceUrl      String?
  sourceType     String        // "official" | "secondary" | "customer" | "angar_estimate"
  lastVerifiedAt DateTime
  confidence     String        // "HIGH" | "MEDIUM" | "LOW"
  previousPrice  Float?
  detectedAt     DateTime      @default(now())
  note           String?

  @@unique([ruleId, kind, region, serviceTier, contextAbove, effectiveFrom])
  @@index([ruleId, kind])
}

// Cambiamenti del mercato AI (prezzi, nuovi modelli, deprecazioni…), ricavati SOLO dai dati
// versionati del catalogo con una fonte (market/detect.ts): mai inventati. Idempotenti per `key`.
model AiMarketChange {
  id           String    @id @default(cuid())
  providerId   String?
  modelId      String?
  productId    String?
  planId       String?
  changeType   String    // "price_change" | "new_model" | "deprecation" | "retirement" | "capability_change" | "new_deployment" | "new_region" | "pricing_tier"
  oldState     Json?
  newState     Json?
  announcedAt  DateTime?
  effectiveAt  DateTime?
  sourceUrl    String?
  sourceType   String    // "official" | "secondary" | "customer" | "angar_estimate"
  confidence   String    // "HIGH" | "MEDIUM" | "LOW"
  detectedAt   DateTime  @default(now())
  summary      String?
  // Chiave deterministica (es. "price:model:openai:gpt-5.6-sol@openai-direct:2026-08-21"): una riga sola per cambiamento.
  key          String?   @unique
  // Regola di prezzo e deployment coinvolti (cambi di prezzo, nuovi deployment / regioni / livelli).
  ruleId       String?
  deploymentId String?
  // "active" | "superseded" (es. una data di ritiro poi cambiata: resta nello storico, non nel feed).
  status       String    @default("active")
  // Da dove è stato ricavato: "catalog" (versioni del catalogo), "sync" (differenza vista alla sincronizzazione), "admin".
  origin       String?

  impacts AiMarketChangeImpact[]

  @@index([changeType, effectiveAt])
  @@index([modelId])
  @@index([status, effectiveAt])
}

// Impatto di un cambiamento del mercato sull'AI estate di un'azienda (market/impact.ts),
// ricalcolato dal job giornaliero (e su richiesta se vecchio): il feed legge da qui.
model AiMarketChangeImpact {
  id                 String         @id @default(cuid())
  organizationId     String
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  changeId           String
  change             AiMarketChange @relation(fields: [changeId], references: [id], onDelete: Cascade)
  systems            Int
  applications       Int
  teams              Int
  systemIds          String[]       @default([])
  // Spesa mensile esposta (quota delle AI coinvolte): reale e stimata separate.
  exposedActualEur   Float          @default(0)
  exposedEstimatedEur Float         @default(0)
  // Variazione annua stimata (prezzo nuovo − vecchio × uso osservato); null = non calcolabile.
  annualDeltaEur     Float?
  deltaBasis         String?
  alternatives       Int            @default(0)
  daysUntil          Int?
  material           Boolean        @default(false)
  detail             Json?
  computedAt         DateTime       @default(now())
  alertedAt          DateTime?

  @@unique([organizationId, changeId])
  @@index([organizationId, material])
}

// Freschezza del catalogo: ultima verifica umana di ogni fonte (pagina ufficiale) per area.
// id = "<area>|<url>". La data in codice (catalog-data) resta; vale la più recente delle due.
model AiCatalogSource {
  id             String   @id
  area           String   // "pricing" | "lifecycle" | "capabilities"
  url            String
  providerId     String?
  lastVerifiedAt DateTime
  verifiedBy     String?
  note           String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@index([area])
}

// ───────────────────────── Economia AI: livello del cliente ─────────────────────────
// Abbonamento di un'azienda a un prodotto AI, normalizzato: piano, righe di posti per tipo,
// listino vs prezzo di contratto vs importo fatturato. Collegato all'AI (AiAsset).
// AiSystemCost resta il costo mensile "attuale" della singola AI (e il registro contratti):
// pricing/subscriptions.ts deriva da lì gli abbonamenti (origin "derived"); quelli inseriti
// a mano o da contratto (origin "manual") non vengono mai riscritti.
model CustomerSubscription {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aiAssetId         String?
  aiAsset           AiAsset?     @relation(fields: [aiAssetId], references: [id], onDelete: SetNull)
  providerId        String?
  productId         String?
  product           AiProduct?   @relation(fields: [productId], references: [id])
  planId            String?
  plan              AiPlan?      @relation(fields: [planId], references: [id])
  billingModel      String       // stessa tassonomia di AiPricingRule
  billingCycle      String?      // "monthly" | "annual" | "usage"
  contractStart     DateTime?
  renewalDate       DateTime?
  currency          String       @default("EUR")
  // Importi MENSILI nella valuta indicata. null = non noto (mai sostituire uno con l'altro).
  listMonthly       Float?       // listino del fornitore × posti
  contractMonthly   Float?       // prezzo negoziato, se noto
  discountPct       Float?
  actualMonthly     Float?       // importo realmente fatturato (banca, fattura, billing)
  taxIncluded       Boolean?
  source            String       // "bank" | "invoice" | "billing_connector" | "manual" | "contract" | "estimate"
  confidence        String       @default("MEDIUM")
  origin            String       @default("derived") // "derived" (da AiSystemCost) | "manual"
  effectiveFrom     DateTime     @default(now())
  effectiveUntil    DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  // Abbonamento inserito a mano (origin "manual"): prodotto/piano fuori catalogo ("Other"),
  // periodo in cui è espresso il prezzo di contratto, importo fatturato col suo periodo,
  // nota e chi l'ha inserito. I prezzi di contratto delle righe sono nella valuta `currency`.
  productName       String?
  planName          String?
  contractPeriod    String?      // "month" | "year": come è stato inserito il prezzo di contratto
  billedAmount      Float?       // importo fatturato così come inserito
  billedPeriod      String?      // "month" | "quarter" | "year"
  note              String?
  enteredByName     String?
  enteredByEmail    String?
  enteredAt         DateTime?

  seatLines CustomerSeatLine[]

  @@index([organizationId])
  @@index([aiAssetId])
}

// Una riga di posti: N posti di un tipo (es. 35 Standard + 4 Premium nello stesso abbonamento).
model CustomerSeatLine {
  id                String               @id @default(cuid())
  subscriptionId    String
  subscription      CustomerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  seatTypeId        String?
  seatType          AiSeatType?          @relation(fields: [seatTypeId], references: [id])
  label             String
  paidSeats         Int
  activeSeats       Int?
  unitListPrice     Float?   // al mese, nella valuta del listino
  unitContractPrice Float?   // al mese, se noto
  currency          String   @default("USD")

  @@index([subscriptionId])
}

// ───────────────────────── AI Estate: grafo delle dipendenze ─────────────────────────
// Catena: Processo → Applicazione → AI system (AiAsset) → Modello (AiModel) → Fornitore
// (AiProvider) / Deployment → Dati (DataAsset) → Owner/Team → Costo.
// Regola: MAI inventare un arco. Ogni arco ha provenienza: "observed" (dai dati: log del
// Gateway, SKU della fatturazione cloud, connettori), "declared" (scritto da una persona)
// o "inferred" (dedotto: etichettato, da confermare o rifiutare). Modello→fornitore e
// deployment→fornitore vengono dal catalogo globale (non salvati qui).

// Un processo aziendale (es. "Customer support"): dichiarato da un admin.
model BusinessProcess {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  criticality    String       @default("medium") // "low" | "medium" | "high" | "critical"
  description    String?
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
}

// Un'applicazione che usa l'AI: SaaS (Zendesk) o interna. Dichiarata da un admin, oppure
// osservata (una chiave del Gateway = un'app che chiama i modelli; externalRef "gateway-key:<id>").
model Application {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  vendor         String?
  kind           String       @default("internal") // "saas" | "internal"
  source         String       @default("declared") // "observed" | "declared"
  externalRef    String?
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, externalRef])
  @@index([organizationId])
}

// Un AI system usa questo modello (su questo deployment), con quota di traffico o di spesa.
// key = origine|modello normalizzato|deployment: upsert idempotente dal job giornaliero.
model AiAssetModelUse {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aiAssetId       String
  aiAsset         AiAsset      @relation(fields: [aiAssetId], references: [id], onDelete: Cascade)
  key             String
  rawModel        String       // come compare nei dati: "gpt-4o-2024-08-06", "Claude Sonnet 4.5"
  modelId         String?      // AiModel.id del catalogo, se riconosciuto
  match           String?      // "exact" | "prefix" | "family" (family = modello più vicino del catalogo)
  providerId      String?      // AiProvider.id del modello
  deploymentId    String?      // AiDeployment.id: "openai-direct", "azure-openai", "aws-bedrock"…
  region          String?
  share           Float?       // 0..1 del traffico (token) o della spesa dell'AI system; null = non noto
  shareBasis      String?      // "tokens" | "spend"
  inputTokens30d  Int?
  outputTokens30d Int?
  requests30d     Int?
  spendEur30d     Float?
  endpoints       String[]     @default([]) // endpoint del Gateway visti: "chat/completions", "embeddings", "messages"
  maxPromptTokens Int?         // prompt più lungo visto (Gateway): requisito minimo di contesto
  source          String       // "observed" | "declared" | "inferred"
  origin          String       // "gateway" | "cloud_billing" | "provider_usage" | "asset_record" | "user"
  confidence      String       @default("MEDIUM")
  evidence        Json?
  status          String       @default("active") // "active" | "confirmed" | "rejected" | "stale"
  reviewedBy      String?
  reviewedAt      DateTime?
  firstSeenAt     DateTime     @default(now())
  lastSeenAt      DateTime     @default(now())

  @@unique([aiAssetId, key])
  @@index([organizationId])
  @@index([modelId])
}

// Arco generico e tipizzato del grafo: "from" usa / dipende da / appartiene a "to".
// Entità: "process" | "application" | "system" | "data" | "team" | "person" | "product" | "provider".
// observedKey: chiave stabile per l'upsert idempotente; gli archi dichiarati hanno origin "user".
// Un arco rifiutato resta (status "rejected") così il job non lo ricrea.
model Dependency {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromType       String
  fromId         String
  toType         String
  toId           String
  relation       String       // "uses" | "calls" | "reads" | "owned_by" | "subscribes" | "provided_by"
  source         String       // "observed" | "declared" | "inferred"
  origin         String       // "gateway" | "data_link" | "owner" | "department" | "subscription" | "service_product" | "asset_vendor" | "user"
  confidence     String       @default("MEDIUM")
  evidence       Json?
  observedKey    String
  status         String       @default("active") // "active" | "confirmed" | "rejected" | "stale"
  createdBy      String?
  reviewedBy     String?
  reviewedAt     DateTime?
  firstSeenAt    DateTime     @default(now())
  lastSeenAt     DateTime     @default(now())

  @@unique([organizationId, observedKey])
  @@index([organizationId, fromType, fromId])
  @@index([organizationId, toType, toId])
}

// Requisiti dichiarati di un AI system (Replaceability ed Exit readiness). Senza
// dichiarazione angar è prudente: richiede tutto ciò che il modello attuale sa fare.
model AiSystemProfile {
  id                   String   @id @default(cuid())
  aiAssetId            String   @unique
  aiAsset              AiAsset  @relation(fields: [aiAssetId], references: [id], onDelete: Cascade)
  requiredCapabilities String[] @default([]) // chiavi di Capabilities: "toolCalling", "vision"…
  notRequired          String[] @default([])
  minContextTokens     Int?
  providerSpecific     String[] @default([]) // funzioni proprie del fornitore usate (testo breve)
  euResidencyRequired  Boolean?
  dataExport           Boolean? // posti: export dei dati disponibile (dichiarato)
  updatedBy            String?
  updatedAt            DateTime @updatedAt
}

// Una prova di comportamento dell'alternativa sul carico reale (o un pilota, per i posti).
// Registrata da una persona con i numeri della prova; mai generata da angar.
model AiEvaluation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aiAssetId      String
  aiAsset        AiAsset      @relation(fields: [aiAssetId], references: [id], onDelete: Cascade)
  candidateType  String       // "model" | "product"
  candidateId    String       // AiModel.id o AiProduct.id
  tasks          Int          // casi provati
  passRate       Float        // 0..1
  passed         Boolean
  method         String?      // "eval suite" | "pilot" | "shadow traffic"
  notes          String?
  evaluatedAt    DateTime     @default(now())
  createdBy      String?

  @@index([organizationId])
  @@index([aiAssetId])
}

// Impact Simulator: scenari salvati ("cosa succede se…") per rivederli. Solo la query dell'URL
// (?s=replace-model&from=…&to=…): il risultato si ricalcola sempre, mai salvato.
model ImpactScenario {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  query          String
  createdBy      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

// Opportunities (motore decisionale): stato delle opportunità che NON nascono dal motore dei
// risparmi (quelle usano SavingAction / SavingDismissal). Chiave = chiave deterministica
// dell'opportunità ("dep:<assetId>", "mkt:<changeKey>"…); il contenuto si ricalcola sempre.
model OpportunityState {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  status         String   // "new" | "accepted" | "in_progress" | "done" | "dismissed"
  title          String?  // titolo al momento del cambio di stato (per l'elenco "In progress")
  note           String?
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId, status])
}
